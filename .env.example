# Copy to .env.local. Never commit .env.local.

# Tatum (dashboard.tatum.io): Sui mainnet GraphQL reads
TATUM_API_KEY=

# Walrus Memory (memory.walrus.xyz/dashboard)
MEMWAL_ACCOUNT_ID=
MEMWAL_KEY=

# Owner wallet that owns the Walrus Memory account and receives MPP payments (address only)
SUI_ADDRESS=

# Anthropic: fact extraction and cover letters (claude-haiku-5-5)
ANTHROPIC_API_KEY=

# Server wallet: creates Seal share grants, pays Walrus storage for shared packs, runs the demo agent
SERVER_SUI_ADDRESS=
SERVER_SUI_PRIVATE_KEY=

# Random secret binding MPP challenges to this server
MPP_SECRET_KEY=
