# Copy this file to .env.local and fill it in. .env.local is gitignored and never committed.

# 1. Tatum (dashboard.tatum.io)
TATUM_API_KEY=
TATUM_ACCOUNT_ID=

# 2. Walrus Memory (memory.walrus.xyz/dashboard)
MEMWAL_ACCOUNT_ID=
MEMWAL_KEY=
MEMWAL_AGENT_ID=

# 3. Sui wallet that owns the Walrus Memory account (address only, never the private key here)
SUI_ADDRESS=

# 4. Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
